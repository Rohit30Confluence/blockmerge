{
  "expo": {
    "name": "BlockMerge",
    "slug": "blockmerge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F1226"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.blockmerge",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.yourcompany.blockmerge",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F1226"
      }
    },
    "plugins": ["expo-haptics"],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
